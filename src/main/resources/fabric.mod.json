{
  "schemaVersion": 1,
  "id": "herzium",
  "version": "${version}",
  "name": "Herzium",
  "description": "Responsive hotbar previews with three selection-order preferences. Herzium (last input) order by default; it changes real slot priority, and Vanilla order is one click away.",
  "authors": [
    "zymekoh"
  ],
  "icon": "assets/herzium/icon.png",
  "license": "MIT",
  "contact": {
    "homepage": "https://modrinth.com/mod/herzium",
    "sources": "https://github.com/kerlycanelita/Herzium",
    "issues": "https://github.com/kerlycanelita/Herzium/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.zymekoh.herzium.HerziumClient"
    ],
    "modmenu": ["dev.zymekoh.herzium.compat.ModMenuIntegration"]
  },
  "mixins": [
    {
      "config": "herzium.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "kohsium": "*",
    "modmenu": "*"
  }
}

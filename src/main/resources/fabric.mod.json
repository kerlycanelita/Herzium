{
  "schemaVersion": 1,
  "id": "herzium",
  "version": "${version}",
  "name": "Herzium",
  "description": "Makes Priority Hotbar its primary input feature, removes active-window VSync and FPS limits, and leaves Raw Input and cursor placement entirely Vanilla-owned.",
  "authors": [
    "zymekoh"
  ],
  "icon": "assets/herzium/icon.png",
  "license": "MIT",
  "contact": {
    "homepage": "https://modrinth.com/mod/herzium",
    "sources": "https://github.com/kerlycanelita/Herzium",
    "issues": "https://github.com/kerlycanelita/Herzium/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.zymekoh.herzium.HerziumClient"
    ]
  },
  "mixins": [
    {
      "config": "herzium.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "kohsium": "*"
  }
}
